def map_enriched_to_row(record: dict) -> dict:
    # Parse award_value from formatted text like "EUR 6010567.55"
    award_value = None
    award_currency = None
    txt = (record.get("award_value") or "").replace(",", "").strip()
    parts = txt.split()
    if len(parts) == 2 and parts[0].isalpha():
        award_currency = parts[0].upper()
        try:
            award_value = float(parts[1])
        except ValueError:
            pass

    # notice_id: wir verwenden publication_id als stabile ID pro Veröffentlichung
    return {
        "notice_id": record.get("publication_id"),
        "project_id": record.get("project_id"),
        "publication_id": record.get("publication_id"),
        "publication_number": None,
        "pub_type": record.get("pub_type"),
        "project_type": record.get("project_type"),
        "process_type": record.get("process_type"),
        "order_type": record.get("order_type"),
        "title": record.get("title"),
        "description": record.get("description"),
        "cpv_main": (record.get("cpv") or "").split(";")[0] if record.get("cpv") else None,
        "cpv_label_de": None,
        "country": record.get("country"),
        "canton": record.get("canton"),
        "city": record.get("city"),
        "publication_date": record.get("publication_date"),
        "award_decision_date": None,
        "submission_deadline": record.get("submission_deadline"),
        "award_value": award_value,
        "award_currency": award_currency,
        "proc_office_name": record.get("proc_office_name"),
        "source": "simap.ch",
    }

UPSERT_SQL = """
insert into simap.notices
(notice_id, project_id, publication_id, publication_number,
 pub_type, project_type, process_type, order_type,
 title, description,
 cpv_main, cpv_label_de,
 country, canton, city,
 publication_date, award_decision_date, submission_deadline,
 award_value, award_currency,
 proc_office_name, source, updated_at)
values
(%(notice_id)s, %(project_id)s, %(publication_id)s, %(publication_number)s,
 %(pub_type)s, %(project_type)s, %(process_type)s, %(order_type)s,
 %(title)s, %(description)s,
 %(cpv_main)s, %(cpv_label_de)s,
 %(country)s, %(canton)s, %(city)s,
 %(publication_date)s, %(award_decision_date)s, %(submission_deadline)s,
 %(award_value)s, %(award_currency)s,
 %(proc_office_name)s, %(source)s, now())
on conflict (notice_id) do update set
  project_id = excluded.project_id,
  publication_id = excluded.publication_id,
  publication_number = excluded.publication_number,
  pub_type = excluded.pub_type,
  project_type = excluded.project_type,
  process_type = excluded.process_type,
  order_type = excluded.order_type,
  title = excluded.title,
  description = excluded.description,
  cpv_main = excluded.cpv_main,
  cpv_label_de = excluded.cpv_label_de,
  country = excluded.country,
  canton = excluded.canton,
  city = excluded.city,
  publication_date = excluded.publication_date,
  award_decision_date = excluded.award_decision_date,
  submission_deadline = excluded.submission_deadline,
  award_value = excluded.award_value,
  award_currency = excluded.award_currency,
  proc_office_name = excluded.proc_office_name,
  source = excluded.source,
  updated_at = now();
"""

def upsert_to_supabase(rows: list[dict]) -> None:
    # Reads DATABASE_URL from .env and performs UPSERTs
    load_dotenv()
    db_url = os.getenv("DATABASE_URL")
    if not db_url:
        raise RuntimeError("DATABASE_URL fehlt in .env")
    with psycopg.connect(db_url, autocommit=True) as conn:
        with conn.cursor() as cur:
            for r in rows:
                cur.execute(UPSERT_SQL, r)

def run(args):
    # existing code to process and enrich projects
    records = []  # assume this is filled with enriched project dicts

    df = pd.DataFrame(records)
    df.to_csv(args.output, index=False, quoting=csv.QUOTE_NONNUMERIC)
    logging.info("Wrote %s rows to %s.", len(df), args.output)

    # Mapping -> Upsert in Supabase
    try:
        mapped = [map_enriched_to_row(r) for r in records]
        upsert_to_supabase(mapped)
        logging.info("Supabase: %s Datensätze upserted.", len(mapped))
    except Exception as e:
        logging.error("Supabase-Upsert fehlgeschlagen: %s", e)