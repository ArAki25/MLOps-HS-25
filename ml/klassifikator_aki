class SeedKeywordExtractor:
    """Extrahiert Keywords automatisch aus Seed-Projekten."""
    
    def __init__(self, min_df: int = 2, max_df: float = 0.7, ngram_range: Tuple[int, int] = (1, 3)):
        self.min_df = min_df
        self.max_df = max_df
        self.ngram_range = ngram_range
        self.tfidf_vectorizer = None
        self.stopwords = self._get_stopwords()
    
    def _get_stopwords(self) -> Set[str]:
        """Deutsche + Ausschreibungs-Stopwords."""
        german = {
            'der', 'die', 'das', 'den', 'dem', 'des', 'ein', 'eine', 'einer', 'einem', 'einen',
            'und', 'oder', 'aber', 'für', 'mit', 'bei', 'von', 'zu', 'zur', 'zum', 'auf', 'aus',
            'nach', 'vor', 'über', 'unter', 'durch', 'als', 'auch', 'noch', 'nur', 'so', 'wie',
            'wenn', 'dass', 'ist', 'sind', 'war', 'wird', 'werden', 'wurde', 'hat', 'haben',
            'nicht', 'sich', 'es', 'sie', 'er', 'wir', 'ihr', 'ich', 'an', 'im', 'am', 'um',
        }
        procurement = {
            'ausschreibung', 'vergabe', 'auftrag', 'angebot', 'submission', 'offerte',
            'beschaffung', 'verfahren', 'gemäss', 'dokumente', 'unterlagen', 'bedingungen',
            'kriterien', 'zuschlag', 'termine', 'frist', 'einreichung', 'schweiz', 'kanton',
            'gemeinde', 'publikation', 'keine', 'angabe', 'siehe', 'weitere', 'informationen',
            'chf', 'franken', 'projekt', 'leistung', 'arbeiten', 'arbeit',
        }
        return german | procurement
    
    def _preprocess(self, text: str) -> str:
        if not text:
            return ""
        text = text.lower()
        text = re.sub(r'(\b[a-z]+)\s*(\d+(?:\.\d+)?)', r'\1_\2', text)  # bkp 224 → bkp_224
        text = re.sub(r'[^\w\s]', ' ', text)
        return re.sub(r'\s+', ' ', text).strip()
    
    def _postprocess(self, keywords: List[str]) -> List[str]:
        processed, seen = [], set()
        for kw in keywords:
            kw = kw.replace('_', ' ').strip()
            if len(kw) < 3 or kw.replace(' ', '').isdigit():
                continue
            kw_lower = kw.lower()
            if kw_lower in seen:
                continue
            # Substring-Check
            if not any(kw_lower in s or s in kw_lower for s in seen):
                seen.add(kw_lower)
                processed.append(kw)
        return processed
    
    def extrahiere(
        self,
        df: pd.DataFrame,
        positive_ids: Set[str],
        negative_ids: Set[str],
        text_column: str = 'combined_text',
        top_n_must: int = 15,
        top_n_should: int = 20,
        top_n_exclude: int = 10
    ) -> Dict[str, Any]:
        """
        Extrahiert Keywords via TF-IDF Differenz + Chi² Test.
        
        Returns:
            {'keywords_must': [...], 'keywords_should': [...], 'keywords_exclude': [...], 'stats': {...}}
        """
        print("\n" + "=" * 60)
        print("KEYWORD-EXTRAKTION AUS SEEDS")
        print("=" * 60)
        
        # Seeds finden
        pos_mask = self._match_ids(df, positive_ids)
        neg_mask = self._match_ids(df, negative_ids)
        
        df_pos = df[pos_mask]
        df_neg = df[neg_mask] if neg_mask.sum() >= 3 else df[~pos_mask].sample(min(100, (~pos_mask).sum()), random_state=42)
        
        print(f"  Positive Seeds: {len(df_pos)} / {len(positive_ids)}")
        print(f"  Negative Seeds: {len(df_neg)}")
        
        if len(df_pos) < 3:
            raise ValueError(f"Zu wenige positive Seeds ({len(df_pos)}). Mindestens 3 benötigt.")
        
        # Texte vorbereiten
        texts_pos = df_pos[text_column].apply(self._preprocess).tolist()
        texts_neg = df_neg[text_column].apply(self._preprocess).tolist()
        all_texts = texts_pos + texts_neg
        labels = np.array([1] * len(texts_pos) + [0] * len(texts_neg))
        
        # TF-IDF
        self.tfidf_vectorizer = TfidfVectorizer(
            min_df=self.min_df, max_df=self.max_df, ngram_range=self.ngram_range,
            stop_words=list(self.stopwords), token_pattern=r'(?u)\b\w[\w_]+\b'
        )
        tfidf_matrix = self.tfidf_vectorizer.fit_transform(all_texts)
        features = self.tfidf_vectorizer.get_feature_names_out()
        
        print(f"  Vokabular: {len(features)} Terme")
        
        # TF-IDF Differenz
        tfidf_pos = tfidf_matrix[:len(texts_pos)].mean(axis=0).A1
        tfidf_neg = tfidf_matrix[len(texts_pos):].mean(axis=0).A1
        discriminance = tfidf_pos - tfidf_neg
        
        # Chi² für Signifikanz
        count_vec = CountVectorizer(vocabulary=self.tfidf_vectorizer.vocabulary_, token_pattern=r'(?u)\b\w[\w_]+\b')
        count_matrix = count_vec.fit_transform(all_texts)
        chi2_scores, _ = chi2(count_matrix, labels)
        
        # Kombinierter Score
        combined = discriminance * np.sqrt(chi2_scores + 1)
        sorted_idx = np.argsort(combined)
        
        # Keywords extrahieren
        must_idx = sorted_idx[-top_n_must:][::-1]
        keywords_must = [features[i] for i in must_idx if combined[i] > 0]
        
        should_idx = sorted_idx[-(top_n_must + top_n_should):-top_n_must][::-1]
        keywords_should = [features[i] for i in should_idx if combined[i] > 0]
        
        exclude_idx = sorted_idx[:top_n_exclude]
        keywords_exclude = [features[i] for i in exclude_idx if combined[i] < 0]
        
        # Postprocessing
        keywords_must = self._postprocess(keywords_must)
        keywords_should = self._postprocess(keywords_should)
        keywords_exclude = self._postprocess(keywords_exclude)
        
        print(f"\n  Extrahiert:")
        print(f"    MUST: {keywords_must[:7]}...")
        print(f"    SHOULD: {keywords_should[:5]}...")
        print(f"    EXCLUDE: {keywords_exclude}")
        
        return {
            'keywords_must': keywords_must,
            'keywords_should': keywords_should,
            'keywords_exclude': keywords_exclude,
            'stats': {
                'n_positive': len(df_pos),
                'n_negative': len(df_neg),
                'vocabulary_size': len(features),
            }
        }
    
    def extrahiere_mit_embeddings(
        self,
        df: pd.DataFrame,
        positive_ids: Set[str],
        embedding_model,
        text_column: str = 'combined_text',
        top_n: int = 15
    ) -> List[str]:
        """Extrahiert Phrasen via Embedding-Ähnlichkeit zum Centroid."""
        pos_mask = self._match_ids(df, positive_ids)
        texts_pos = df.loc[pos_mask, text_column].tolist()
        
        if len(texts_pos) < 3:
            return []
        
        # Centroid berechnen
        embeddings = embedding_model.encode(
            [f"passage: {t}" for t in texts_pos],
            convert_to_numpy=True, normalize_embeddings=True
        )
        centroid = embeddings.mean(axis=0)
        centroid /= np.linalg.norm(centroid)
        
        # Kandidaten-Phrasen
        all_phrases = []
        for text in texts_pos:
            words = self._preprocess(text).split()
            for n in [1, 2, 3]:
                for i in range(len(words) - n + 1):
                    phrase = ' '.join(words[i:i+n])
                    if len(phrase) >= 4 and phrase not in self.stopwords:
                        all_phrases.append(phrase)
        
        phrase_counts = Counter(all_phrases)
        frequent = [p for p, c in phrase_counts.most_common(150) if c >= 2]
        
        if not frequent:
            return []
        
        # Ranking nach Centroid-Ähnlichkeit
        phrase_emb = embedding_model.encode(
            [f"query: {p}" for p in frequent],
            convert_to_numpy=True, normalize_embeddings=True
        )
        similarities = np.dot(phrase_emb, centroid)
        top_idx = np.argsort(similarities)[-top_n:][::-1]
        
        return self._postprocess([frequent[i] for i in top_idx])
    
    def _match_ids(self, df: pd.DataFrame, id_set: Set[str]) -> pd.Series:
        if not id_set:
            return pd.Series(False, index=df.index)
        
        normalized = {str(x).strip().lower() for x in id_set}
        normalized |= {str(x).strip().lower().lstrip('0') or '0' for x in id_set}
        
        mask = pd.Series(False, index=df.index)
        for col in ['id', 'simap_project_id', 'simap_publication_id']:
            if col not in df.columns:
                continue
            col_str = df[col].astype(str).str.strip().str.lower()
            mask |= col_str.isin(normalized)
            col_stripped = col_str.str.lstrip('0').replace('', '0')
            mask |= col_stripped.isin(normalized)
        
        return mask


