class SupabaseLoader:
    """Lädt Daten aus Supabase."""
    
    def __init__(self):
        self.url = os.getenv('SUPABASE_URL')
        self.key = os.getenv('SUPABASE_SERVICE_KEY') or os.getenv('SUPABASE_KEY')
        
        if not self.url or not self.key:
            raise ValueError("SUPABASE_URL und SUPABASE_KEY müssen gesetzt sein")
        
        self.headers = {
            'apikey': self.key,
            'Authorization': f'Bearer {self.key}',
            'Content-Type': 'application/json'
        }
    
    def teste_verbindung(self) -> bool:
        import requests
        try:
            response = requests.get(f"{self.url}/rest/v1/", headers=self.headers, timeout=5)
            return response.status_code in [200, 404]
        except:
            return False
    
    def lade_projekte(self, tage_zurueck: int = 365, limit: int = 50000, tabelle: str = 'projects') -> pd.DataFrame:
        import requests

        alle_daten, offset, batch_size = [], 0, 1000
        start_date = (datetime.now() - timedelta(days=tage_zurueck)).strftime('%Y-%m-%d')

        print(f"Lade Projekte seit {start_date}...")

        while offset < limit:
            url = f"{self.url}/rest/v1/{tabelle}?select=*&publication_date=gte.{start_date}&order=publication_date.desc&offset={offset}&limit={batch_size}"

            try:
                response = requests.get(url, headers=self.headers, timeout=60)
                if response.status_code != 200:
                    print(f"  API Fehler: {response.status_code} - {response.text[:200]}")
                    break
                batch = response.json()
                if not batch:
                    break
                alle_daten.extend(batch)
                offset += len(batch)
                if len(batch) < batch_size:
                    break
            except Exception as e:
                print(f"  Fehler: {e}")
                break

        df = pd.DataFrame(alle_daten) if alle_daten else pd.DataFrame()

        # Feld-Mapping (projects-Tabelle hat andere Spaltennamen)
        if 'title_de' in df.columns and 'title' not in df.columns:
            df['title'] = df['title_de'].fillna(df.get('title_fr', ''))
        if 'description_de' in df.columns and 'description' not in df.columns:
            df['description'] = df['description_de'].fillna(df.get('description_fr', ''))
        if 'cpv_code_main' in df.columns and 'cpv_code' not in df.columns:
            df['cpv_code'] = df['cpv_code_main']
        if 'award_amount' in df.columns and 'estimated_amount' not in df.columns:
            df['estimated_amount'] = df['award_amount']

        print(f"✓ {len(df):,} Projekte geladen")
        return df
    
    def lade_seeds(self, tabelle: str = 'seed_labels') -> Tuple[Set[str], Set[str]]:
        import requests
        positive, negative = set(), set()
        
        try:
            response = requests.get(
                f"{self.url}/rest/v1/{tabelle}?select=project_id,is_positive",
                headers=self.headers, timeout=10
            )
            if response.status_code == 200:
                for row in response.json():
                    (positive if row['is_positive'] else negative).add(str(row['project_id']))
                print(f"✓ Seeds: {len(positive)} pos, {len(negative)} neg")
        except Exception as e:
            print(f"⚠ Seeds nicht geladen: {e}")
        
        return positive, negative


