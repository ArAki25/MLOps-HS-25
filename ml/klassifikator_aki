@dataclass
class FilterKriterien:
    """Konfiguration für Projekt-Filterung und Label-Generierung."""
    
    # Domain Filter (vor Training)
    order_types: List[str] = field(default_factory=list)
    cpv_domain: List[str] = field(default_factory=list)
    
    # Präferenz Filter (nach Prediction)
    kantone: List[str] = field(default_factory=list)
    cpv_codes: List[str] = field(default_factory=list)
    project_types: List[str] = field(default_factory=list)
    min_budget: Optional[float] = None
    max_budget: Optional[float] = None
    nur_offene_deadlines: bool = True
    min_probability: float = 0.6
    
    # Keywords (manuell ODER automatisch aus Seeds)
    keywords_must: List[str] = field(default_factory=list)
    keywords_should: List[str] = field(default_factory=list)
    keywords_exclude: List[str] = field(default_factory=list)
    keywords_auto_extracted: bool = False  # Flag ob automatisch extrahiert
    
    # Seeds
    seed_positive_ids: Set[str] = field(default_factory=set)
    seed_negative_ids: Set[str] = field(default_factory=set)
    seed_weight: float = 3.0
    
    # Thresholds
    semantic_threshold_must: float = 0.55
    semantic_threshold_should: float = 0.45
    semantic_threshold_exclude: float = 0.50
    
    def to_dict(self) -> Dict[str, Any]:
        return {
            'order_types': self.order_types,
            'cpv_domain': self.cpv_domain,
            'kantone': self.kantone,
            'cpv_codes': self.cpv_codes,
            'project_types': self.project_types,
            'min_budget': self.min_budget,
            'max_budget': self.max_budget,
            'nur_offene_deadlines': self.nur_offene_deadlines,
            'min_probability': self.min_probability,
            'keywords_must': self.keywords_must,
            'keywords_should': self.keywords_should,
            'keywords_exclude': self.keywords_exclude,
            'keywords_auto_extracted': self.keywords_auto_extracted,
            'seed_positive_ids': list(self.seed_positive_ids),
            'seed_negative_ids': list(self.seed_negative_ids),
            'seed_weight': self.seed_weight,
            'semantic_threshold_must': self.semantic_threshold_must,
            'semantic_threshold_should': self.semantic_threshold_should,
            'semantic_threshold_exclude': self.semantic_threshold_exclude,
        }
    
    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> 'FilterKriterien':
        data = data.copy()
        if 'seed_positive_ids' in data:
            data['seed_positive_ids'] = set(data['seed_positive_ids'])
        if 'seed_negative_ids' in data:
            data['seed_negative_ids'] = set(data['seed_negative_ids'])
        return cls(**data)


