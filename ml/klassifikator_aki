    # =========================================================================
    # KEYWORD EXTRAKTION AUS SEEDS
    # =========================================================================
    
    def extrahiere_keywords_aus_seeds(
        self,
        df: pd.DataFrame,
        positive_ids: Set[str],
        negative_ids: Set[str],
        use_embeddings: bool = True,
        top_n_must: int = 15,
        top_n_should: int = 20,
        top_n_exclude: int = 10
    ) -> Dict[str, List[str]]:
        """
        Extrahiert Keywords automatisch aus Seed-Projekten.
        
        Args:
            df: DataFrame mit Projekten
            positive_ids: IDs positiver Seeds
            negative_ids: IDs negativer Seeds
            use_embeddings: Auch Embedding-basierte Extraktion?
            
        Returns:
            {'keywords_must': [...], 'keywords_should': [...], 'keywords_exclude': [...]}
        """
        if 'combined_text' not in df.columns:
            df = self.daten_vorbereiten(df)
        
        # TF-IDF + Chi² Extraktion
        result = self.keyword_extractor.extrahiere(
            df=df,
            positive_ids=positive_ids,
            negative_ids=negative_ids,
            top_n_must=top_n_must,
            top_n_should=top_n_should,
            top_n_exclude=top_n_exclude
        )
        
        # Optional: Embedding-basierte Phrasen
        if use_embeddings:
            embedding_phrases = self.keyword_extractor.extrahiere_mit_embeddings(
                df=df,
                positive_ids=positive_ids,
                embedding_model=self.embedding_model,
                top_n=10
            )
            # Zu SHOULD hinzufügen
            result['keywords_should'] = list(set(result['keywords_should'] + embedding_phrases))
            print(f"  + {len(embedding_phrases)} Embedding-Phrasen zu SHOULD")
        
        return result
    
    def erstelle_kriterien_aus_seeds(
        self,
        df: pd.DataFrame,
        positive_ids: Set[str],
        negative_ids: Set[str],
        order_types: List[str] = None,
        cpv_domain: List[str] = None,
        kantone: List[str] = None,
        min_probability: float = 0.6,
        use_embeddings: bool = True
    ) -> FilterKriterien:
        """
        Erstellt komplette FilterKriterien automatisch aus Seeds.
        
        Der User muss NUR positive/negative IDs angeben - alle Keywords
        werden automatisch extrahiert!
        """
        # Keywords extrahieren
        keywords = self.extrahiere_keywords_aus_seeds(
            df=df,
            positive_ids=positive_ids,
            negative_ids=negative_ids,
            use_embeddings=use_embeddings
        )
        
        # Kriterien erstellen
        kriterien = FilterKriterien(
            order_types=order_types or [],
            cpv_domain=cpv_domain or [],
            kantone=kantone or [],
            min_probability=min_probability,
            keywords_must=keywords['keywords_must'],
            keywords_should=keywords['keywords_should'],
            keywords_exclude=keywords['keywords_exclude'],
            keywords_auto_extracted=True,
            seed_positive_ids=positive_ids,
            seed_negative_ids=negative_ids,
        )
        
        print("\n✓ Kriterien automatisch erstellt")
        return kriterien
    
    # =========================================================================
    # KRITERIEN SETZEN
    # =========================================================================
    
    def set_kriterien(self, kriterien: FilterKriterien):
        """Setzt Kriterien und berechnet Keyword-Embeddings."""
        self.kriterien = kriterien
        
        print("\n" + "-" * 40)
        print("Kriterien aktiviert")
        print("-" * 40)
        
        if kriterien.keywords_must:
            prefixed = [f"query: {kw}" for kw in kriterien.keywords_must]
            self._kw_must_emb = self.embedding_model.encode(prefixed, convert_to_numpy=True, normalize_embeddings=True)
            print(f"  MUST: {len(kriterien.keywords_must)} keywords")
        
        if kriterien.keywords_should:
            prefixed = [f"query: {kw}" for kw in kriterien.keywords_should]
            self._kw_should_emb = self.embedding_model.encode(prefixed, convert_to_numpy=True, normalize_embeddings=True)
            print(f"  SHOULD: {len(kriterien.keywords_should)} keywords")
        
        if kriterien.keywords_exclude:
            prefixed = [f"query: {kw}" for kw in kriterien.keywords_exclude]
            self._kw_exclude_emb = self.embedding_model.encode(prefixed, convert_to_numpy=True, normalize_embeddings=True)
            print(f"  EXCLUDE: {len(kriterien.keywords_exclude)} keywords")
        
        print(f"  Seeds: {len(kriterien.seed_positive_ids)} pos, {len(kriterien.seed_negative_ids)} neg")
        if kriterien.keywords_auto_extracted:
            print(f"  ✓ Keywords wurden automatisch aus Seeds extrahiert")
    
    # =========================================================================
    # HELPER METHODS
    # =========================================================================
    
    def _match_ids(self, df: pd.DataFrame, id_set: Set[str]) -> pd.Series:
        if not id_set:
            return pd.Series(False, index=df.index)
        
        normalized = {str(x).strip().lower() for x in id_set}
        normalized |= {str(x).strip().lower().lstrip('0') or '0' for x in id_set}
        
        mask = pd.Series(False, index=df.index)
        for col in ['id', 'simap_project_id', 'simap_publication_id']:
            if col not in df.columns:
                continue
            col_str = df[col].astype(str).str.strip().str.lower()
            mask |= col_str.isin(normalized)
            col_stripped = col_str.str.lstrip('0').where(col_str.str.lstrip('0') != '', '0')
            mask |= col_stripped.isin(normalized)
        
        return mask
    
    def daten_vorbereiten(self, df: pd.DataFrame) -> pd.DataFrame:
        df = df.copy()
        df['title'] = df['title'].fillna('').apply(normalisiere_text)
        df['description'] = df['description'].fillna('').apply(lambda x: normalisiere_text(x, 1200))
        df['combined_text'] = df['title'] + ' ' + df['title'] + ' ' + df['description']
        
        for col in self.categorical_features:
            if col in df.columns:
                df[col] = df[col].fillna('unknown').astype(str)
        
        return df
    
    # =========================================================================
    # FILTER
    # =========================================================================
    
    def wende_domain_filter_an(self, df: pd.DataFrame, schuetze_seeds: bool = True) -> pd.DataFrame:
        if self.kriterien is None:
            return df
        
        filtered, original = df.copy(), len(df)
        kriterien = self.kriterien
        
        # Seeds schützen
        seed_ids = kriterien.seed_positive_ids | kriterien.seed_negative_ids
        df_seeds = filtered[self._match_ids(filtered, seed_ids)].copy() if schuetze_seeds and seed_ids else pd.DataFrame()
        
        if kriterien.order_types and 'order_type' in filtered.columns:
            order_lower = [o.lower().strip() for o in kriterien.order_types]
            filtered = filtered[filtered['order_type'].fillna('').str.lower().str.strip().isin(order_lower)]
        
        if kriterien.cpv_domain and 'cpv_code' in filtered.columns:
            cpv_mask = pd.Series(False, index=filtered.index)
            for prefix in kriterien.cpv_domain:
                cpv_mask |= filtered['cpv_code'].astype(str).str.startswith(str(prefix))
            filtered = filtered[cpv_mask]
        
        # Seeds wiederherstellen
        if len(df_seeds) > 0:
            lost = df_seeds[~df_seeds.index.isin(filtered.index)]
            if len(lost) > 0:
                filtered = pd.concat([filtered, lost])
        
        print(f"  Domain Filter: {original:,} → {len(filtered):,}")
        return filtered
    
    def wende_praeferenz_filter_an(self, df: pd.DataFrame) -> pd.DataFrame:
        if self.kriterien is None:
            return df
        
        filtered, kriterien = df.copy(), self.kriterien
        
        if 'wahrscheinlichkeit' in filtered.columns:
            filtered = filtered[filtered['wahrscheinlichkeit'] >= kriterien.min_probability]
        
        if kriterien.kantone and 'canton' in filtered.columns:
            kantone_upper = [k.upper().strip() for k in kriterien.kantone]
            filtered = filtered[filtered['canton'].fillna('').str.upper().str.strip().isin(kantone_upper)]
        
        if kriterien.cpv_codes and 'cpv_code' in filtered.columns:
            cpv_mask = pd.Series(False, index=filtered.index)
            for prefix in kriterien.cpv_codes:
                cpv_mask |= filtered['cpv_code'].astype(str).str.startswith(str(prefix))
            filtered = filtered[cpv_mask]
        
        if kriterien.min_budget and 'estimated_amount' in filtered.columns:
            filtered = filtered[(filtered['estimated_amount'] >= kriterien.min_budget) | filtered['estimated_amount'].isna()]
        
        if kriterien.nur_offene_deadlines:
            for col in ['submission_deadline', 'deadline']:
                if col in filtered.columns:
                    filtered[col] = pd.to_datetime(filtered[col], errors='coerce', utc=True)
                    filtered = filtered[(filtered[col] >= pd.Timestamp.now(tz='UTC')) | filtered[col].isna()]
                    break
        
        print(f"  Präferenz Filter: {len(df):,} → {len(filtered):,}")
        return filtered
    
    # =========================================================================
    # TEMPORAL SPLIT
    # =========================================================================
    
    def temporal_split(
        self, df: pd.DataFrame, date_column: str = 'publication_date',
        val_ratio: float = 0.15, test_ratio: float = 0.15
    ) -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
        
        df = df.copy()
        df[date_column] = pd.to_datetime(df[date_column], errors='coerce', utc=True)
        df['_sort'] = df[date_column].fillna(pd.Timestamp.max.tz_localize('UTC'))
        df = df.sort_values('_sort').reset_index(drop=True)
        
        n = len(df)
        test_start = int(n * (1 - test_ratio))
        val_start = int(n * (1 - test_ratio - val_ratio))
        
        df_train = df.iloc[:val_start].drop('_sort', axis=1)
        df_val = df.iloc[val_start:test_start].drop('_sort', axis=1)
        df_test = df.iloc[test_start:].drop('_sort', axis=1)
        
        # Seeds zu Train verschieben
        if self.kriterien:
            seed_ids = self.kriterien.seed_positive_ids | self.kriterien.seed_negative_ids
            for split_df, name in [(df_val, 'val'), (df_test, 'test')]:
                mask = self._match_ids(split_df, seed_ids)
                if mask.sum() > 0:
                    df_train = pd.concat([df_train, split_df[mask]])
                    if name == 'val':
                        df_val = df_val[~mask]
                    else:
                        df_test = df_test[~mask]
        
        print(f"  Split: Train={len(df_train):,}, Val={len(df_val):,}, Test={len(df_test):,}")
        return df_train.reset_index(drop=True), df_val.reset_index(drop=True), df_test.reset_index(drop=True)
    
    # =========================================================================
    # EMBEDDINGS & SCORES
    # =========================================================================
    
    def berechne_text_embeddings(self, df: pd.DataFrame) -> np.ndarray:
        texts = [f"passage: {row.get('title', '')[:200]} {row.get('title', '')[:200]} {row.get('description', '')[:800]}" 
                 for _, row in df.iterrows()]
        return self.embedding_model.encode(texts, convert_to_numpy=True, normalize_embeddings=True, batch_size=256, show_progress_bar=len(texts) > 500)
    
    def berechne_semantic_scores(self, embeddings: np.ndarray) -> Dict[str, np.ndarray]:
        scores = {}
        if self._kw_must_emb is not None:
            sim = np.dot(embeddings, self._kw_must_emb.T)
            scores['must_max'] = np.max(sim, axis=1)
            scores['must_mean'] = np.mean(sim, axis=1)
        if self._kw_should_emb is not None:
            sim = np.dot(embeddings, self._kw_should_emb.T)
            scores['should_max'] = np.max(sim, axis=1)
            scores['should_mean'] = np.mean(sim, axis=1)
        if self._kw_exclude_emb is not None:
            sim = np.dot(embeddings, self._kw_exclude_emb.T)
            scores['exclude_max'] = np.max(sim, axis=1)
        return scores
    
    # =========================================================================
    # LABELS & FEATURES
    # =========================================================================
    
    def generiere_labels(self, df: pd.DataFrame, scores: Dict[str, np.ndarray], mode: str = 'full') -> Tuple[np.ndarray, np.ndarray, Optional[str]]:
        n = len(df)
        labels, weights = np.zeros(n, dtype=int), np.ones(n)
        
        pos_mask = self._match_ids(df, self.kriterien.seed_positive_ids)
        neg_mask = self._match_ids(df, self.kriterien.seed_negative_ids)
        
        labels[pos_mask.values] = 1
        labels[neg_mask.values] = 0
        weights[pos_mask.values | neg_mask.values] = self.kriterien.seed_weight
        
        seed_mask = pos_mask | neg_mask
        label_source = None
        
        if mode == 'full':
            if 'must_max' in scores:
                score, threshold, label_source = scores['must_max'], self.kriterien.semantic_threshold_must, 'must_max'
            elif 'should_max' in scores:
                score, threshold, label_source = scores['should_max'], self.kriterien.semantic_threshold_should, 'should_max'
            else:
                score = None
            
            if score is not None:
                labels[(score >= threshold) & ~seed_mask.values] = 1
                if 'exclude_max' in scores:
                    exclude = scores['exclude_max']
                    labels[(exclude >= self.kriterien.semantic_threshold_exclude) & (exclude > score) & ~seed_mask.values] = 0
        
        return labels, weights, label_source
    
    def erstelle_features(self, df: pd.DataFrame, scores: Dict[str, np.ndarray], y: np.ndarray = None, fit: bool = False, exclude: Set[str] = None) -> np.ndarray:
        features, names, exclude = [], [], exclude or set()
        
        for name, score in scores.items():
            base = name.replace('_max', '').replace('_mean', '')
            if name not in exclude and not any(base in e for e in exclude):
                features.append(score.reshape(-1, 1))
                names.append(f'sem_{name}')
        
        cats = [c for c in self.categorical_features if c in df.columns]
        if fit and y is not None:
            self.target_encoder.fit(df, y, cats)
        cat_feat = self.target_encoder.transform(df, cats)
        if cat_feat.shape[1] > 0:
            features.append(cat_feat)
            names.extend([f'te_{c}' for c in cats if c in self.target_encoder.encodings])
        
        if 'estimated_amount' in df.columns:
            vals = np.log1p(pd.to_numeric(df['estimated_amount'], errors='coerce').fillna(0).abs().values).reshape(-1, 1)
            features.append(vals)
            names.append('num_budget')
        
        self._feature_names = names
        return np.hstack(features) if features else np.zeros((len(df), 1))
    
    # =========================================================================
    # TRAINING
    # =========================================================================
    
    def trainieren(self, df_train: pd.DataFrame, df_val: pd.DataFrame, df_test: pd.DataFrame, model_name: str = None, model_version: str = "v1.0") -> Dict[str, float]:
        print("\n" + "=" * 60)
        print("TRAINING")
        print("=" * 60)
        
        # Embeddings
        print("\n[1/5] Embeddings...")
        emb_train = self.berechne_text_embeddings(df_train)
        emb_test = self.berechne_text_embeddings(df_test)
        
        # Scores
        print("[2/5] Semantic Scores...")
        scores_train = self.berechne_semantic_scores(emb_train)
        scores_test = self.berechne_semantic_scores(emb_test)
        
        # Labels
        print("[3/5] Labels...")
        y_train, w_train, label_source = self.generiere_labels(df_train, scores_train, 'full')
        y_test, _, _ = self.generiere_labels(df_test, scores_test, 'seeds_only')
        
        n_pos = y_train.sum()
        print(f"  Train: {n_pos} pos, {len(y_train)-n_pos} neg")
        
        # Features
        print("[4/5] Features...")
        exclude = {label_source, label_source.replace('_max', '_mean')} if label_source else set()
        self._excluded_features = exclude
        
        X_train = self.erstelle_features(df_train, scores_train, y_train, fit=True, exclude=exclude)
        X_test = self.erstelle_features(df_test, scores_test, exclude=exclude)
        print(f"  {len(self._feature_names)} Features")
        
        # Training
        print("[5/5] Model...")
        n = len(X_train)
        params = {'n_estimators': min(300, max(50, n//3)), 'max_depth': 3 if n < 500 else 4, 'learning_rate': 0.05, 'subsample': 0.8, 'random_state': 42}
        
        base = GradientBoostingClassifier(**params)
        self.classifier = CalibratedClassifierCV(base, method='sigmoid', cv=3) if n >= 200 else base
        self.classifier.fit(X_train, y_train, sample_weight=w_train)
        
        # Evaluation
        y_pred = self.classifier.predict(X_test)
        y_prob = self.classifier.predict_proba(X_test)[:, 1]
        
        metrics = {'train_accuracy': float((self.classifier.predict(X_train) == y_train).mean())}
        
        seed_mask = self._match_ids(df_test, self.kriterien.seed_positive_ids) | self._match_ids(df_test, self.kriterien.seed_negative_ids)
        if seed_mask.sum() > 0:
            metrics['test_seed_accuracy'] = float((y_pred[seed_mask.values] == y_test[seed_mask.values]).mean())
            print(f"\n  ⭐ Test Seed Accuracy: {metrics['test_seed_accuracy']:.3f}")
        
        if len(np.unique(y_test)) == 2:
            metrics['test_f1'] = float(f1_score(y_test, y_pred, zero_division=0))
            metrics['test_auc'] = float(roc_auc_score(y_test, y_prob))
            print(f"  Test F1: {metrics['test_f1']:.3f}, AUC: {metrics['test_auc']:.3f}")
        
        self._training_stats = {'n_train': len(df_train), 'n_test': len(df_test), 'metrics': metrics}
        return metrics
    
    # =========================================================================
    # INFERENCE
    # =========================================================================
    
    def vorhersagen(self, df: pd.DataFrame, wende_filter_an: bool = True) -> pd.DataFrame:
        if self.classifier is None:
            raise ValueError("Modell nicht trainiert!")
        
        df = self.daten_vorbereiten(df)
        df = self.wende_domain_filter_an(df, schuetze_seeds=False)
        
        if len(df) == 0:
            return pd.DataFrame()
        
        emb = self.berechne_text_embeddings(df)
        scores = self.berechne_semantic_scores(emb)
        X = self.erstelle_features(df, scores, exclude=self._excluded_features)
        
        df = df.copy()
        df['vorhersage'] = self.classifier.predict(X)
        df['wahrscheinlichkeit'] = self.classifier.predict_proba(X)[:, 1]
        
        if wende_filter_an:
            df = self.wende_praeferenz_filter_an(df)
        
        return df.sort_values('wahrscheinlichkeit', ascending=False)
    
    # =========================================================================
    # SPEICHERN / LADEN
    # =========================================================================
    
    def speichern(self, pfad: str):
        if self.classifier is None:
            raise ValueError("Kein Modell!")
        
        joblib.dump({
            'classifier': self.classifier,
            'target_encoder': self.target_encoder,
            'kriterien': self.kriterien.to_dict() if self.kriterien else None,
            'kw_must_emb': self._kw_must_emb,
            'kw_should_emb': self._kw_should_emb,
            'kw_exclude_emb': self._kw_exclude_emb,
            'feature_names': self._feature_names,
            'excluded_features': list(self._excluded_features),
            'training_stats': self._training_stats,
            'version': 'v5.1'
        }, pfad)
        print(f"✓ Gespeichert: {pfad}")
    
    def laden(self, pfad: str):
        data = joblib.load(pfad)
        self.classifier = data['classifier']
        self.target_encoder = data.get('target_encoder', TargetEncoderProper())
        if data.get('kriterien'):
            self.kriterien = FilterKriterien.from_dict(data['kriterien'])
        self._kw_must_emb = data.get('kw_must_emb')
        self._kw_should_emb = data.get('kw_should_emb')
        self._kw_exclude_emb = data.get('kw_exclude_emb')
        self._feature_names = data.get('feature_names', [])
        self._excluded_features = set(data.get('excluded_features', []))
        print(f"✓ Geladen (Version {data.get('version', '?')})")


