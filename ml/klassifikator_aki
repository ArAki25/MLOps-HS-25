class TargetEncoderProper:
    """Target Encoding mit Smoothing - Fit nur auf Training!"""
    
    def __init__(self, smoothing: float = 10.0):
        self.smoothing = smoothing
        self.encodings: Dict[str, Dict[str, float]] = {}
        self.global_means: Dict[str, float] = {}
        self._fitted = False
    
    def fit(self, df: pd.DataFrame, y: np.ndarray, columns: List[str]) -> 'TargetEncoderProper':
        if len(df) != len(y):
            raise ValueError(f"df ({len(df)}) und y ({len(y)}) müssen gleich lang sein")
        
        global_mean = float(y.mean())
        
        for col in columns:
            if col not in df.columns:
                continue
            
            col_data = df[col].fillna('__MISSING__').astype(str)
            self.global_means[col] = global_mean
            
            stats = pd.DataFrame({'target': y, 'category': col_data.values})
            agg = stats.groupby('category')['target'].agg(['mean', 'count'])
            
            encoding = {}
            for cat, row in agg.iterrows():
                smoothed = (row['count'] * row['mean'] + self.smoothing * global_mean) / (row['count'] + self.smoothing)
                encoding[cat] = float(smoothed)
            
            self.encodings[col] = encoding
        
        self._fitted = True
        return self
    
    def transform(self, df: pd.DataFrame, columns: List[str]) -> np.ndarray:
        if not self._fitted:
            raise ValueError("TargetEncoder muss zuerst gefittet werden!")
        
        result = []
        for col in columns:
            if col not in df.columns or col not in self.encodings:
                continue
            
            col_data = df[col].fillna('__MISSING__').astype(str)
            global_mean = self.global_means.get(col, 0.5)
            encoded = col_data.map(self.encodings[col]).fillna(global_mean).values
            result.append(encoded.reshape(-1, 1))
        
        return np.hstack(result) if result else np.zeros((len(df), 0))


