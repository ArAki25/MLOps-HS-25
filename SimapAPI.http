# FINALES, FUNKTIONIERENDES MUSTER
# (Benötigt manuelle Extraktion des Tokens und Cookies aus dem Browser)

POST https://www.simap.ch/shab/backend/publikation/v1/publikationen/search
Content-Type: application/json
Accept: application/json
x-csrf-token: YOUR_ACTUAL_CSRF_TOKEN
Cookie: YOUR_ACTUAL_COOKIE


{
    "pageable": {
        "page": 0,
        "size": 10
    },
    "sort": {
        "orders": [
            {
                "property": "publicationDate",
                "direction": "DESC"
            }
        ]
    }
}