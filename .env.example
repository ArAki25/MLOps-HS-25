# =====================================================================
# SIMAP PROJECT - Umgebungsvariablen
# =====================================================================
#
# Kopiere diese Datei zu .env und fülle die Werte aus!
# WICHTIG! Die .env Datei niemals auf Github pushen (enthält Passwort!)
#
# =====================================================================

# ---------------------------------------------------------------------
# SUPABASE DATABASE (PostgreSQL)
# ---------------------------------------------------------------------
# So findest du deine DATABASE_URL:
# 1. Gehe zu https://supabase.com
# 2. Öffne dein Projekt
# 3. Settings → Database → Connection String → URI
# 4. Kopiere die komplette Connection String
# 5. Ersetze [YOUR-PASSWORD] mit deinem echten Passwort

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xyzabc.supabase.co:5432/postgres

# Beispiel (echter Wert sieht so aus):
# DATABASE_URL=postgresql://postgres:mySecretPassword123@db.xyzabc.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# ML MODEL CONFIGURATION (optional)
# ---------------------------------------------------------------------
# Pfad zum trainierten Modell (falls du ein Standard-Modell verwendest)
# MODEL_PATH=./models/mein_modell.pkl

# ---------------------------------------------------------------------
# FLASK APP (optional, für Web UI)
# ---------------------------------------------------------------------
# FLASK_ENV=development
# FLASK_DEBUG=True
# SECRET_KEY=your-secret-key-here
