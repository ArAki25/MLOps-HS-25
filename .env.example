# Supabase Database URL
# Kopiere diese Datei zu .env und fülle die Werte aus!
#
# So findest du deine DATABASE_URL:
# 1. Gehe zu https://supabase.com
# 2. Öffne dein Projekt
# 3. Settings → Database → URI → PostgreSQL
# 4. Kopiere die komplette Connection String

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.supabase.co:5432/postgres


# WICHTIG! deine .env niemals pushen auf Github, DA IST DAS PASSWORT DRINNEN
