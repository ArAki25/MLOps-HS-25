## Supabase (lokal)
# Projekt URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Public (anon) Key – für read-only / clientseitige Zugriffe
SUPABASE_ANON_KEY=your-anon-key

# Service Role Key – NUR lokal für Admin/ETL/Backends, niemals committen
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

## Flask
# Session-Signierung. In Produktion PFLICHT (App startet sonst nicht).
# Generieren: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Bind-Adresse. Dev-Default ist 127.0.0.1; Deployment setzt 0.0.0.0.
# HOST=127.0.0.1
# PORT=5000

## Chatbot "Bob" (Groq) – ohne Key antwortet Bob mit einer Fallback-Meldung
GROQ_API_KEY=

## Admin-Testdashboard (/admin/test-runs) – nur für lokale Testläufe
ENABLE_TEST_DASHBOARD=false

